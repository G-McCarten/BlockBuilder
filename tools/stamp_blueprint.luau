--[[
	stamp_blueprint: builds a blueprint from a script or a Studio model,
	validates it, and writes src/shared/Blueprints/<Name>.luau.

	  lune run tools/stamp_blueprint <Name>          build, validate, write
	  lune run tools/stamp_blueprint <Name> --check  fail if the file is missing or stale

	Run from the repo root. The source is one of:

	  tools/blueprints/<Name>.luau           a script returning a Blueprint.Source
	  tools/blueprints/<Name>.rbxm or .rbxmx  a Studio model of grid-aligned
	                                          parts, read by tools/lib/ModelSource

	Reach is checked with SiteConfig's base grasp and headroom.
]]

local fs = require("@lune/fs")
local luau = require("@lune/luau")
local process = require("@lune/process")

local Blueprint = require("../src/shared/Blueprint")
local BlueprintValidator = require("../src/shared/BlueprintValidator")
local SiteConfig = require("../src/shared/SiteConfig")
local ModelSource = require("./lib/ModelSource")

local name = process.args[1]
local check = process.args[2] == "--check"
if name == nil or not string.match(name, "^[%w_]+$") then
	print("usage: lune run tools/stamp_blueprint <Name> [--check]")
	process.exit(2)
end

local outPath = `src/shared/Blueprints/{name}.luau`
local sourcePath, source
for _, ext in { "luau", "rbxm", "rbxmx" } do
	local path = `tools/blueprints/{name}.{ext}`
	if fs.isFile(path) then
		if sourcePath then
			print(`both {sourcePath} and {path} exist: keep one`)
			process.exit(2)
		end
		sourcePath = path
		if ext == "luau" then
			source = luau.load(fs.readFile(path), { debugName = path })()
		else
			source = ModelSource.fromContents(fs.readFile(path), name, SiteConfig.BLOCK_STUDS)
		end
	end
end
if sourcePath == nil then
	print(`no source for {name}: expected tools/blueprints/{name}.luau, .rbxm or .rbxmx`)
	process.exit(2)
end

local bp = Blueprint.build(source)

local report = BlueprintValidator.validate(bp, {
	graspCells = SiteConfig.BASE_GRASP_CELLS,
	headroomCells = SiteConfig.HEADROOM_CELLS,
})
local stats = report.stats
print(
	`{name}: {stats.count} slots, {stats.sizeX} x {stats.sizeY} x {stats.sizeZ} cells, `
		.. `{stats.overhangs} overhangs, {stats.extraSupports} extra supports, depth {stats.depth}`
)
if not report.ok then
	print(`{report.errorCount} problems:`)
	for _, message in report.errors do
		print(`  {message}`)
	end
	process.exit(1)
end

local data = Blueprint.encode(bp)

-- The packed form must unpack to exactly what was built.
local back = Blueprint.decode(data, bp.name, bp.palette)
for _, field in { "x", "y", "z", "kind", "facing", "physical", "supportStart", "supportList" } do
	local a, b = (bp :: any)[field], (back :: any)[field]
	if #a ~= #b then
		error(`round trip changed {field}`)
	end
	for i = 1, #a do
		if a[i] ~= b[i] then
			error(`round trip changed {field}[{i}]`)
		end
	end
end

local palette = {}
for _, kind in bp.palette do
	table.insert(palette, string.format("%q", kind))
end
local text = table.concat({
	`-- Generated by tools/stamp_blueprint.luau from {sourcePath}. Don't edit by hand.`,
	`-- {stats.count} slots, {stats.sizeX} x {stats.sizeY} x {stats.sizeZ} cells, depth {stats.depth}.`,
	"return {",
	`\tname = {string.format("%q", bp.name)},`,
	string.format("\tpalette = { %s },", table.concat(palette, ", ")),
	`\tcount = {bp.count},`,
	`\tdata = "{data}",`,
	"}",
	"",
}, "\n")

if check then
	if not fs.isFile(outPath) then
		print(`{outPath} is missing: stamp it`)
		process.exit(1)
	end
	local current = string.gsub(fs.readFile(outPath), "\r\n", "\n")
	if current ~= text then
		print(`{outPath} is stale: stamp it again`)
		process.exit(1)
	end
	print(`{outPath} is current`)
else
	if not fs.isDir("src/shared/Blueprints") then
		fs.writeDir("src/shared/Blueprints")
	end
	fs.writeFile(outPath, text)
	print(`wrote {outPath} ({#data} characters of data)`)
end
